new file mode 100644
index 0000000..3701a8c
--- /dev/null
+++ b/src/quant_research/liquid_cohort.py
@@ -0,0 +1,245 @@
+"""The registered 2019-formed liquid cohort; no post-formation representative search.
+
+Qualification uses raw amounts before any return dependency is inspected.
+Unknown input raises rather than manufacturing a successful cash decision.
+"""
+from bisect import bisect_left
+
+import numpy as np
+import pandas as pd
+
+from .strategy import StrategyBlockedError, TargetDecision, _cutoff, _prepare, _snapshot
+from .temporal import master_record, TemporalStateError
+
+
+LIQUID_SCOPE = "R1I_HISTORICAL_LIQUID_V1"
+FRAME_SHA256 = "55b7b554d5e785b91a743960dec5f84f45bfdac13c70f191fd5f71c308e58b7a"
+
+
+def _formation(dataset):
+    selected = dataset.manifest.get("cohort_selection", {})
+    ids = selected.get("selected_instruments", [])
+    if (selected.get("status") != "FORMED" or selected.get("scope") != LIQUID_SCOPE
+            or selected.get("sampling_frame_sha256") != FRAME_SHA256
+            or selected.get("formation_date") != "2019-12-31"
+            or not isinstance(ids, list) or not 6 <= len(ids) <= 10
+            or not all(isinstance(s, str) for s in ids) or len(set(ids)) != len(ids)):
+        raise StrategyBlockedError("DATA_BLOCKED_SELECTION: frozen6-10 distinct products required")
+    try:
+        at = pd.Timestamp(selected["cohort_available_at"])
+        if at.tzinfo is None or at < pd.Timestamp("2020-01-02T21:00:00+08:00"):
+            raise ValueError("formation cannot backdate2019 month-end")
+    except (KeyError, ValueError, TypeError) as exc:
+        raise StrategyBlockedError("DATA_BLOCKED_SELECTION: invalid formation availability") from exc
+    return tuple(sorted(ids)), at
+
+
+def _blocked(day, sid, field):
+    raise StrategyBlockedError(f"DATA_BLOCKED_LIQUID_COHORT: {day} {sid} {field}")
+
+
+def _check_scope(dataset):
+    fixed_cohort, _ = _formation(dataset)
+    if dataset.manifest.get("research_scope") != LIQUID_SCOPE:
+        raise StrategyBlockedError("DATA_BLOCKED_LIQUID_COHORT: explicit research_scope required")
+    if set(dataset.instruments.instrument_id) != set(fixed_cohort):
+        raise StrategyBlockedError("DATA_BLOCKED_LIQUID_COHORT: all and only the frozen formation identities required")
+    if not dataset.instruments.strategy_universe.eq(LIQUID_SCOPE).all():
+        raise StrategyBlockedError("DATA_BLOCKED_LIQUID_COHORT: master scope mismatch")
+    if not dataset.bars.instrument_id.isin(fixed_cohort).all():
+        raise StrategyBlockedError("DATA_BLOCKED_LIQUID_COHORT: foreign bar identity")
+    calendar = list(dataset.calendar)
+    if not calendar or calendar != sorted(set(calendar)) or any(d >= "2025-01-01" for d in calendar):
+        raise StrategyBlockedError("DATA_BLOCKED_LIQUID_COHORT: sorted pre-2025 calendar required")
+    return calendar
+
+
+def liquid_dependencies(dataset):
+    """Recompute monthly raw-data qualification without reading TR or returns.
+
+    Only complete N>=3 months create ranking/order dependencies. N<3 is
+    common cash for all four rules. This dependency calculation does not
+    itself grant source admission or waive M8 holding-data requirements.
+    """
+    calendar = _check_scope(dataset)
+    fixed_cohort, cohort_available_at = _formation(dataset)
+    bars = _prepare(dataset.bars[["date", "instrument_id", "amount", "suspended", "available_at"]])
+    master = {sid: group.to_dict("records") for sid, group in dataset.instruments.groupby("instrument_id")}
+    schedule, required, qualified = [], set(), set()
+    for index, day in enumerate(calendar):
+        if index + 2 >= len(calendar) or day[:7] == calendar[index + 1][:7]:
+            continue
+        release, execution = calendar[index + 1], calendar[index + 2]
+        if execution < "2020-01-01":
+            continue
+        entry = dict(anchor_date=day, release_date=release, execution_date=execution)
+        if _cutoff(day) < cohort_available_at:
+            schedule.append(dict(entry, status="CASH_COHORT_NOT_YET_KNOWN", eligible=[],
+                                 eligible_count=None, exclusions={}, qualification={}))
+            continue
+        history = _snapshot(bars, _cutoff(release), ["date", "instrument_id"])
+        history = history.loc[history.date.le(day)]
+        eligible, exclusions, qualification = [], {}, {}
+        for sid in fixed_cohort:
+            try:
+                meta = master_record(master[sid], _cutoff(day))
+            except TemporalStateError as exc:
+                _blocked(day, sid, str(exc))
+            if meta is None:
+                _blocked(day, sid, "missing as-of identity/state")
+            if meta.get("asset_type") != "ETF" or meta.get("board") != "ETF":
+                _blocked(day, sid, "unverified ETF identity")
+            if not isinstance(meta.get("account_verified"), (bool, np.bool_)):
+                _blocked(day, sid, "unknown account permission")
+            if not meta["account_verified"] and meta.get("account_permission_status") != "DENIED":
+                _blocked(day, sid, "unverified account permission is not a known denial")
+            status = meta.get("status")
+            if status not in ("NORMAL", "ACTIVE", "SUSPENDED", "ECONOMIC_IDENTITY_CHANGED", "RETIRED"):
+                _blocked(day, sid, "unknown instrument status")
+            listed = meta.get("listed_on")
+            if not isinstance(listed, str):
+                _blocked(day, sid, "unknown listed_on")
+            if listed < calendar[0]:
+                _blocked(day, sid, "calendar does not cover listing age")
+            age = max(0, index - bisect_left(calendar, listed) + 1)
+            evidence = dict(listed_sessions=age, status=status, account_verified=bool(meta["account_verified"]))
+            reason = None
+            retired = meta.get("delisted_on")
+            if listed > day:
+                reason = "NOT_YET_LISTED"
+            elif pd.notna(retired) and retired and retired <= day:
+                reason = "DELISTED"
+            elif pd.notna(retired) and retired:
+                reason = "ANNOUNCED_DELISTING"
+            elif status not in ("NORMAL", "ACTIVE"):
+                reason = status
+            elif not meta["account_verified"]:
+                reason = "PERMISSION_DENIED"
+            elif age < 252:
+                reason = "LISTED_LESS_THAN_252_SESSIONS"
+            else:
+                window = history.loc[history.instrument_id.eq(sid)].set_index("date").reindex(calendar[index - 19:index + 1])
+                amount = pd.to_numeric(window.amount, errors="coerce")
+                if len(window) != 20 or not (np.isfinite(amount) & amount.ge(0)).all():
+                    _blocked(day, sid, "incomplete 20-session amount")
+                if not window.suspended.map(lambda v: isinstance(v, (bool, np.bool_))).all():
+                    _blocked(day, sid, "unknown suspension state")
+                if (window.suspended & amount.ne(0)).any():
+                    _blocked(day, sid, "suspended state conflicts with turnover")
+                evidence["median_amount20"] = float(amount.median())
+                if bool(window.suspended.iloc[-1]):
+                    reason = "SUSPENDED"
+                elif amount.median() < 20_000_000:
+                    reason = "MEDIAN_AMOUNT_BELOW_20000000"
+            qualification[sid] = evidence
+            if reason:
+                exclusions[sid] = reason
+            else:
+                eligible.append(sid)
+        qualified.update(eligible)
+        if len(eligible) >= 3:
+            required.update(eligible)
+        schedule.append(dict(entry, status="QUALIFIED_INPUTS", eligible=eligible,
+                             eligible_count=len(eligible), exclusions=exclusions, qualification=qualification))
+    return dict(method="REGISTERED_HISTORICALLY_FORMED_MONTHLY_QUALIFICATION", research_scope=LIQUID_SCOPE,
+                depends_on_returns=False, cohort=list(fixed_cohort),
+                cohort_available_at=cohort_available_at.isoformat(), schedule=schedule,
+                required_full_history_instruments=sorted(required),
+                qualified_instruments=sorted(qualified),
+                never_eligible_instruments=sorted(set(fixed_cohort) - qualified),
+                no_ranking_or_holding_dependency=sorted(set(fixed_cohort) - required))
+
+
+def generate_liquid_targets(dataset, variant="E0", execution_delay=1):
+    """Generate fixed D/D+1/D+2 monthly targets for the main account engine."""
+    if variant not in ("E0", "R0", "E1", "R1"):
+        raise ValueError("Unregistered cohort variant")
+    if type(execution_delay) is not int or execution_delay not in (1, 2):
+        raise ValueError("Only base and one additional execution session are registered")
+    dependencies = liquid_dependencies(dataset)
+    calendar, decisions = list(dataset.calendar), []
+    positions = {day: i for i, day in enumerate(calendar)}
+    columns = ["date", "instrument_id", "close", "amount", "available_at", "total_return_index"]
+    if "total_return_available_at" in dataset.bars:
+        columns.append("total_return_available_at")
+    bars, benchmark = _prepare(dataset.bars[columns]), _prepare(dataset.benchmark)
+    for entry in dependencies["schedule"]:
+        day, release = entry["anchor_date"], entry["release_date"]
+        index, release_index = positions[day], positions[release]
+        if release_index + execution_delay >= len(calendar):
+            continue
+        execution, at = calendar[release_index + execution_delay], _cutoff(release)
+        known = _snapshot(bars, at, ["date", "instrument_id"])
+        current = known.loc[known.date.eq(release)].set_index("instrument_id")
+        refs = {sid: float(v) for sid, v in current.close.items() if pd.notna(v) and np.isfinite(v) and v > 0}
+        order_window = known.loc[known.date.isin(calendar[release_index - 19:release_index + 1])]
+        adv = {}
+        for sid, rows in order_window.groupby("instrument_id"):
+            amounts = pd.to_numeric(rows.amount, errors="coerce")
+            if len(amounts) == 20 and (np.isfinite(amounts) & amounts.ge(0)).all() and amounts.mean() > 0:
+                adv[sid] = float(amounts.mean())
+        diagnostics = dict(entry, universe=LIQUID_SCOPE, variant=variant, signal_anchor_date=day,
+                           signal_anchor_at=_cutoff(day).isoformat(), signal_release_delay=1,
+                           order_reference_date=release, risk_scaling=False, momentum={}, trend=None)
+        eligible, weights, status = entry["eligible"], {}, entry["status"]
+        if status != "CASH_COHORT_NOT_YET_KNOWN":
+            # Shared signal inputs are verified across all four controls before
+            # producing any one control, so one missing competitor cannot be
+            # silently excluded from ranking or converted to a cash signal.
+            history = known.loc[known.date.le(day)].copy()
+            if "total_return_available_at" in history:
+                clocks = pd.to_datetime(history.total_return_available_at, utc=True, format="mixed", errors="coerce")
+                history.loc[clocks.isna() | clocks.gt(at), "total_return_index"] = np.nan
+            tr = history.pivot(index="date", columns="instrument_id", values="total_return_index")
+            momentum = {}
+            for sid in (eligible if len(eligible) >= 3 else []):
+                for feature_day in (calendar[index - 126], calendar[index - 21]):
+                    if feature_day not in tr.index or sid not in tr or not np.isfinite(tr.at[feature_day, sid]) or tr.at[feature_day, sid] <= 0:
+                        _blocked(day, sid, "missing as-of momentum TR " + feature_day)
+                momentum[sid] = float(np.log(tr.at[calendar[index - 21], sid] / tr.at[calendar[index - 126], sid]))
+                if sid not in refs or sid not in adv:
+                    _blocked(release, sid, "missing release-day order price/ADV20")
+            market = _snapshot(benchmark, at, ["date"]).set_index("date")
+            trend_window = market.total_return_index.reindex(calendar[max(0, index - 199):index + 1])
+            if len(trend_window) != 200 or not (np.isfinite(trend_window) & trend_window.gt(0)).all():
+                _blocked(day, "HS300_TR", "missing 200-session benchmark window")
+            trend = bool(trend_window.iloc[-1] > trend_window.mean())
+            ordered = sorted(momentum, key=lambda sid: (-momentum[sid], sid))
+            diagnostics.update(momentum=momentum, trend=trend, momentum_order=ordered,
+                               ranking_freedom=len(eligible) >= 4)
+            status = "CASH_INSUFFICIENT_PRODUCTS" if len(eligible) < 3 else "OK"
+            if len(eligible) >= 3:
+                chosen = ordered[:3] if variant in ("R0", "R1") else eligible
+                weights = {sid: min(.35, 1 / len(chosen)) for sid in sorted(chosen)}
+                if variant in ("E1", "R1") and not trend:
+                    status, weights = "CASH_TREND_OFF", {}
+        diagnostics["target_gross_weight"] = sum(weights.values())
+        # These are execution priorities, not factor ranks. Equal vectors have
+        # identical order priorities even when momentum ordering differs.
+        ranks = {sid: rank for rank, sid in enumerate(sorted(weights), 1)}
+        decisions.append(TargetDecision(release, execution, at, weights, refs, adv, ranks, status, diagnostics))
+    return decisions
+
+
+def liquid_opportunities(dataset):
+    """Pre-account diagnostics: no simulated or forward portfolio returns."""
+    targets = {variant: generate_liquid_targets(dataset, variant) for variant in ("E0", "R0", "E1", "R1")}
+    start = dataset.manifest.get("funded_account_start", "2020-01-01")
+    rows = []
+    for index, target in enumerate(targets["E0"]):
+        if target.execution_date < start:
+            continue
+        rows.append(dict(anchor_date=target.diagnostics["signal_anchor_date"],
+                         execution_date=target.execution_date,
+                         status=target.status,
+                         eligible_count=target.diagnostics["eligible_count"],
+                         eligible=target.diagnostics["eligible"], trend=target.diagnostics["trend"],
+                         targets={v: ds[index].weights for v, ds in targets.items()},
+                         ranking_targets_differ=target.weights != targets["R0"][index].weights))
+    return dict(research_scope=LIQUID_SCOPE, performance_evidence=False, schedule=rows,
+                funded_account_start=start, scheduled_count=len(rows),
+                legal_anchor_count=sum(row["eligible_count"] is not None for row in rows),
+                preactivation_cash_count=sum(row["eligible_count"] is None for row in rows),
+                n_ge4=sum(row["eligible_count"] is not None and row["eligible_count"] >= 4 for row in rows),
+                trend_on=sum(row["trend"] is True for row in rows),
+                ranking_targets_differ=sum(row["ranking_targets_differ"] for row in rows))
diff --git a/src/quant_research/liquid_runner.py b/src/quant_research/liquid_runner.py
new file mode 100644
index 0000000..8ce7b28
--- /dev/null
+++ b/src/quant_research/liquid_runner.py
@@ -0,0 +1,227 @@
+"""Explicit M8 admission and real account entry; ordinary R1I stays closed."""
+from copy import deepcopy
+from dataclasses import asdict
+from datetime import datetime, timezone
+import hashlib
+import json
+from pathlib import Path
+
+import pandas as pd
+
+from .admission import verify_attestation
+from .liquid_cohort import LIQUID_SCOPE, liquid_dependencies, generate_liquid_targets
+from .data import TABLES, DataValidationError, audit_dataset, load_dataset, save_dataset
+from .evaluation import nav_metrics
+from .execution import run_backtest
+from .provenance import append_event, digest, source_provenance, write_json
+from .runner import dataset_hash, _module_fingerprint
+
+
+IMPORTED_SOURCE_FINGERPRINT = _module_fingerprint()
+REGISTRATION_FILES = ("docs/M8_PLAN.md", "reports/m8_rotation/SOURCE_POLICY_ADDENDUM.md",
+                      "reports/m8_rotation/COHORT_SELECTION.json", "reports/m8_rotation/EXPERIMENT_REGISTRY.json")
+
+
+
+def validate_liquid_config(config):
+    allowed = {"protocol_version", "live_enabled", "sample", "universe", "variant", "initial_cash",
+               "primary_capital_confirmed", "annual_incremental_cost", "risk_scaling", "execution_delay",
+               "cost_multiplier", "slippage_multiplier", "seed", "claim_type", "signal_release_delay"}
+    if set(config) - allowed:
+        raise ValueError("Unknown cohort configuration keys: " + str(sorted(set(config) - allowed)))
+    required = dict(protocol_version="phase2-mvp-0.1", live_enabled=False, universe=LIQUID_SCOPE,
+                    initial_cash=100000, primary_capital_confirmed=True, risk_scaling=False,
+                    signal_release_delay=1, seed=20261114, claim_type="economic_increment")
+    for key, value in required.items():
+        if type(config.get(key)) is not type(value) or config[key] != value:
+            raise ValueError("Unregistered cohort setting: " + key)
+    if config.get("sample") not in ("development", "validation", "synthetic"):
+        raise ValueError("Final holdout is locked")
+    if config.get("variant") not in ("E0", "R0", "E1", "R1"):
+        raise ValueError("Unregistered cohort variant")
+    for key in ("cost_multiplier", "slippage_multiplier", "execution_delay"):
+        if type(config.get(key)) is not int:
+            raise ValueError("Explicit integer cohort execution configuration required")
+    path = tuple(config[k] for k in ("cost_multiplier", "slippage_multiplier", "execution_delay"))
+    if path not in ((1, 1, 1), (2, 2, 1), (3, 3, 1), (1, 1, 2)):
+        raise ValueError("Unregistered cohort pressure path")
+    if "annual_incremental_cost" not in config or config["annual_incremental_cost"] is not None:
+        raise ValueError("The registered32 cohort paths require explicit unknown fixed cost, null")
+
+
+def split_liquid_sample(dataset, sample):
+    """Physically separate market tables; each account starts with fresh cash."""
+    if sample not in ("development", "validation"):
+        raise DataValidationError("Final holdout is locked")
+    if any(day >= "2025-01-01" for day in dataset.calendar):
+        raise DataValidationError("Do not load final-holdout market data into the cohort adapter")
+    result = deepcopy(dataset)
+    end = "2021-12-31" if sample == "development" else "2024-12-31"
+    result.calendar = [day for day in result.calendar if day <= end]
+    result.instruments = result.instruments.loc[result.instruments.available_at.str[:10].le(end)].copy()
+    result.bars = result.bars.loc[result.bars.date.le(end)].copy()
+    result.benchmark = result.benchmark.loc[result.benchmark.date.le(end)].copy()
+    result.actions = result.actions.loc[result.actions.ex_date.le(end)].copy()
+    result.manifest.update(dataset_id="real-m8-historical-liquid-" + sample, dataset_version="admitted-v1",
+                           sample=sample, coverage_start=result.calendar[0], coverage_end=result.calendar[-1],
+                           funded_account_start="2020-01-01" if sample == "development" else "2022-01-01",
+                           warmup_is_not_account_return=True)
+    result.manifest["liquid_dependencies"] = liquid_dependencies(result)
+    result.manifest["required_full_history_instruments"] = result.manifest["liquid_dependencies"]["required_full_history_instruments"]
+    result.manifest.pop("file_sha256", None)
+    return result
+
+
+def admit_liquid_samples(stage, attestation, output, repo):
+    """Reuse the hash-bound independent evidence admission, with new scope."""
+    review = verify_attestation(stage, attestation, repo)
+    if review.get("research_scope") != LIQUID_SCOPE:
+        raise DataValidationError("Independent review must explicitly admit the fixed cohort")
+    dataset = load_dataset(stage, allow_unverified=True)
+    if dataset.manifest.get("synthetic") is not False or dataset.manifest.get("build_blockers"):
+        raise DataValidationError("Only real data with resolved necessary dependencies can be admitted")
+    if review.get("admission_scope") != "FULL_HOLDING_DEPENDENCIES":
+        raise DataValidationError("Independent full holding-source admission required")
+    dataset.manifest.update(status="ADMITTED_DAILY_SCREEN", strategy_runs_permitted=True,
+                            admission_scope="FULL_HOLDING_DEPENDENCIES",
+                            calendar_kind="VERIFIED_EXCHANGE_CALENDAR", evidence_gates=review["evidence_gates"],
+                            admission_attestation=review,
+                            admission_attestation_sha256=hashlib.sha256(Path(attestation).read_bytes()).hexdigest(),
+                            admitted_stage_manifest_sha256=hashlib.sha256((Path(stage) / "manifest.json").read_bytes()).hexdigest(),
+                            performance_evidence_scope="CONDITIONAL_DAILY_SIMULATION_ONLY")
+    for name in TABLES:
+        table = getattr(dataset, name)
+        if not table.quality_status.isin(["provisional", "accepted"]).all():
+            raise DataValidationError("Quarantined records cannot be promoted: " + name)
+        table.loc[:, "quality_status"] = "accepted"
+    summaries = {}
+    for sample in ("development", "validation"):
+        split = split_liquid_sample(dataset, sample)
+        audit = audit_dataset(split)
+        if audit["status"] != "PASSED":
+            raise DataValidationError("Cohort admission audit failed: " + json.dumps(audit))
+        destination = Path(output) / sample
+        save_dataset(split, destination)
+        write_json(destination / "admission_audit.json", audit)
+        summaries[sample] = dict(path=str(destination), sessions=len(split.calendar), bars=len(split.bars),
+                                 first_session=split.calendar[0], last_session=split.calendar[-1], status="PASSED")
+    write_json(Path(output) / "sample_manifest.json", summaries)
+    return summaries
+
+
+def _verify_source_files(dataset, repo):
+    if dataset.manifest.get("synthetic") is True:
+        return
+    selection_path = Path(repo) / "reports/m8_rotation/COHORT_SELECTION.json"
+    if (not selection_path.is_file()
+            or hashlib.sha256(selection_path.read_bytes()).hexdigest() != dataset.manifest.get("cohort_selection_sha256")
+            or json.loads(selection_path.read_bytes()) != dataset.manifest.get("cohort_selection")):
+        raise DataValidationError("Frozen formation selection differs from admitted snapshot")
+    if dataset.manifest.get("admission_scope") != "FULL_HOLDING_DEPENDENCIES":
+        raise DataValidationError("M7 all-cash admission cannot authorize M8 holdings")
+    review = dataset.manifest.get("admission_attestation", {})
+    if review.get("decision") != "ADMIT_DAILY_SCREEN" or review.get("research_scope") != LIQUID_SCOPE:
+        raise DataValidationError("Independent fixed-cohort admission required")
+    bound = dict(dataset.manifest.get("source_snapshot_hashes", {}))
+    bound.update(review.get("evidence_files", {}))
+    if not bound or not review.get("evidence_files"):
+        raise DataValidationError("Missing bound source/admission evidence")
+    root = Path(repo).resolve()
+    for relative, expected in bound.items():
+        path = (root / relative).resolve()
+        path.relative_to(root)
+        if not path.is_file() or hashlib.sha256(path.read_bytes()).hexdigest() != expected:
+            raise DataValidationError("Cohort original/evidence unavailable or changed: " + relative)
+
+
+def run_liquid_experiment(dataset, config, output_root, repo_root):
+    """Run and save one registered path through the corrected main engine.
+
+    The caller runs eight base paths before the other twenty-four. This entry
+    never conditions admission of a pressure path on the profitability of base.
+    """
+    output_root, repo_root = Path(output_root), Path(repo_root)
+    output_root.mkdir(parents=True, exist_ok=True)
+    lock = output_root / ".liquid_runner.lock"
+    with lock.open("x", encoding="utf-8") as stream:
+        stream.write("One cohort writer; retain until runner exits.\n")
+    try:
+        if _module_fingerprint() != IMPORTED_SOURCE_FINGERPRINT:
+            raise RuntimeError("Source changed after import; restart to bind executing cohort code")
+        provenance = source_provenance(repo_root)
+        registered = {name: hashlib.sha256((repo_root / name).read_bytes()).hexdigest() for name in REGISTRATION_FILES}
+        provenance["registration_hashes"] = registered
+        identity = dict(config_hash=digest(config), data_hash=dataset_hash(dataset),
+                        source_hash=provenance["source_hash"], registration_hash=digest(registered))
+        run_id = digest(identity)[:16] + "-" + datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%S%fZ")
+        destination = output_root / run_id
+        destination.mkdir()
+        registry = output_root / "trial_registry.jsonl"
+        write_json(destination / "config.json", config)
+        write_json(destination / "provenance.json", dict(provenance, **identity, run_id=run_id))
+        append_event(registry, dict(run_id=run_id, event="REGISTERED", config=config, **identity))
+        try:
+            validate_liquid_config(config)
+            frozen_registry = json.loads((repo_root / REGISTRATION_FILES[-1]).read_bytes())
+            if frozen_registry.get("plan_sha256") != registered[REGISTRATION_FILES[0]]:
+                raise ValueError("M8 plan differs from frozen preregistration")
+            synthetic = dataset.manifest.get("synthetic") is True
+            if synthetic != (config["sample"] == "synthetic"):
+                raise ValueError("Real and synthetic data must retain their actual labels")
+            if not synthetic:
+                matches = [trial for trial in frozen_registry["trials"] if trial["period"] == config["sample"]
+                           and trial["variant"] == config["variant"]
+                           and all(trial[key] == config[key] for key in
+                                   ("initial_cash", "risk_scaling", "signal_release_delay", "execution_delay",
+                                    "cost_multiplier", "slippage_multiplier", "seed", "annual_incremental_cost"))]
+                if len(matches) != 1:
+                    raise ValueError("Path is absent or ambiguous in frozen32 registry")
+            for relative, expected in {**provenance["source_files"], **registered}.items():
+                content = (repo_root / relative).read_bytes()
+                if hashlib.sha256(content).hexdigest() != expected:
+                    raise RuntimeError("Source changed during immutable run snapshot")
+                target = destination / "source_snapshot" / relative
+                target.parent.mkdir(parents=True, exist_ok=True)
+                target.write_bytes(content)
+            _verify_source_files(dataset, repo_root)
+            audit = audit_dataset(dataset)
+            write_json(destination / "data_audit.json", audit)
+            if audit["errors"] or audit["blockers"] or (not synthetic and audit["status"] != "PASSED"):
+                raise DataValidationError("DATA_BLOCKED_LIQUID_COHORT: necessary input audit failed")
+            end = "2021-12-31" if config["sample"] == "development" else "2024-12-31"
+            if (any(day > end for day in dataset.calendar)
+                    or any(dataset.bars.date.gt(end)) or any(dataset.benchmark.date.gt(end))):
+                raise DataValidationError("Supply physically separate pre-boundary market tables")
+            if dataset.manifest.get("signal_release_delay") != 1:
+                raise DataValidationError("Cohort release clock must match audited data")
+            decisions = generate_liquid_targets(dataset, config["variant"], config["execution_delay"])
+            start = "2022-01-01" if config["sample"] == "validation" else "2020-01-01"
+            decisions = [decision for decision in decisions if decision.execution_date >= start]
+            write_json(destination / "decisions.json", [dict(asdict(d), decision_at=d.decision_at.isoformat()) for d in decisions])
+            result = run_backtest(dataset, decisions, config["initial_cash"],
+                                  cost_multiplier=config["cost_multiplier"],
+                                  slippage_multiplier=config["slippage_multiplier"], start_date=start)
+            write_json(destination / "execution_assumptions.json", {key: value for key, value in result.items()
+                                                                    if not isinstance(value, pd.DataFrame)})
+            hashes = {}
+            for name, table in result.items():
+                if isinstance(table, pd.DataFrame):
+                    payload = table.to_json(orient="records", date_format="iso", double_precision=15).encode("utf-8")
+                    (destination / (name + ".json")).write_bytes(payload)
+                    hashes[name] = hashlib.sha256(payload).hexdigest()
+            metrics = nav_metrics(result["nav"], config["initial_cash"])
+            metrics.update(status="SYNTHETIC_ENGINEERING_ONLY" if synthetic else "DAILY_SCREEN_ONLY", run_id=run_id,
+                           research_scope=LIQUID_SCOPE,
+                           economic_confirmation="BLOCKED_HURDLE" if config.get("annual_incremental_cost") is None else "NOT_PERFORMED")
+            write_json(destination / "metrics.json", metrics)
+            write_json(destination / "table_hashes.json", hashes)
+            write_json(destination / "uncertainty.json", dict(status="NOT_A_CONFIRMATORY_TEST", reason="Paired registered evaluation required"))
+            append_event(registry, dict(run_id=run_id, event="COMPLETED", status=metrics["status"], table_hashes=hashes))
+            return destination, metrics
+        except BaseException as error:
+            failure = dict(run_id=run_id, event="FAILED", error=type(error).__name__, reason=str(error))
+            write_json(destination / "failure.json", failure)
+            append_event(registry, failure)
+            raise
+    finally:
+        lock.unlink()
