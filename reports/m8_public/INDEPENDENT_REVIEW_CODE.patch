+]
+
+
+def compact(text): return re.sub(r"\s+","",text)
+def chinese(day):
+    y,m,d = map(int,day.split("-"))
+    return f"{y}年{m}月{d}日"
+
+
+def run():
+    docs = read(ROOT/"reports/m8_rotation/holding_documents.json")
