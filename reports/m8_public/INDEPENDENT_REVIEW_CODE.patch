+    assert "Ａ股、Ｂ股股权转让书据" in statutory["mof_2008_stamp"]
+    assert "股票和以股票为基础的存托凭证" in statutory["guangdong_2023_stamp_law"]
+    assert "A股交易过户费" in statutory["sse_2015_joint_fees"]
